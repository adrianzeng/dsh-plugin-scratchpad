{
  "name": "dsh-plugin-scratchpad",
  "version": "2.0.0",
  "description": "Quick notes for DeepSeek Harness: a left-sidebar notepad with Chinese reminder-time detection, host SQLite storage, three model tools, and an optional manual promote-to-ideas step. · 速记便签：左侧栏便签，中文提醒时间自动识别，便签存在宿主 SQLite 里，带三个模型工具和可选的人工投递。",
  "license": "MIT",
  "author": "adrianzeng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianzeng/dsh-plugin-scratchpad.git"
  },
  "homepage": "https://github.com/adrianzeng/dsh-plugin-scratchpad#readme",
  "bugs": {
    "url": "https://github.com/adrianzeng/dsh-plugin-scratchpad/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notes",
    "scratchpad",
    "reminders",
    "productivity",
    "sqlite"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5.0",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
